# TrueNAS Connection Settings
TRUENAS_HOST=192.168.37.33
TRUENAS_SMB_SHARE=rsmb/NVR
TRUENAS_SMB_USER=
# Obscure your password using: rclone obscure "your_password"
TRUENAS_SMB_PASS_OBSCURED=

# Rclone Remote Specification
# Inline connection string (no rclone.conf required):
RCLONE_REMOTE=:smb,host=${TRUENAS_HOST},user=${TRUENAS_SMB_USER},pass=${TRUENAS_SMB_PASS_OBSCURED}:${TRUENAS_SMB_SHARE}

# Alternatively, if you have a named remote configured:
# RCLONE_REMOTE=truenas:NVR

# Rclone VFS Cache Performance Tuning
RCLONE_VFS_CACHE_MODE=full
RCLONE_VFS_CACHE_MAX_SIZE=50G
RCLONE_VFS_CACHE_MAX_AGE=24h
RCLONE_DIR_CACHE_TIME=2h

# Rclone Connection Timeouts (Sleep/Suspend Resilience)
RCLONE_TIMEOUT=10s
RCLONE_CONTIMEOUT=5s
RCLONE_LOW_LEVEL_RETRIES=3
RCLONE_RETRIES=3

